# 文镕 WenRong 环境变量示例
# 复制为 .env 后填入真实值，.env 不要提交到 git

# 服务端口
PORT=4090

# SQLite 数据文件路径（Docker 内固定为 /app/data/wenrong.sqlite，由 volume 挂载持久化）
WENRONG_DB=/app/data/wenrong.sqlite

# 用于加密存储 LLM 供应商 API Key 的密钥；首次部署随机生成，之后不要改动（改动会导致已存的 Key 无法解密）
ENCRYPTION_KEY=change-me-to-a-random-long-string

# 默认 LLM 供应商初始化参数（仅在数据库中还没有任何供应商时，首次启动用来创建一条默认记录）
DEFAULT_PROVIDER_BASE_URL=http://192.168.88.62:3001/
DEFAULT_PROVIDER_MODEL=claude-sonnet-4-5
# 出于安全考虑，默认不在此处写入真实 API Key；留空后首次启动会创建一个空 Key 的供应商记录，
# 部署后请登录管理后台 /admin，在「LLM 供应商」页编辑该记录填入正确的 API Key。
DEFAULT_PROVIDER_API_KEY=

# 统一账号中心（acc.909939.xyz）OAuth 公共客户端（PKCE）
ACC_BASE=https://acc.909939.xyz
ACC_CLIENT_ID=
ACC_REDIRECT_URI=http://192.168.88.47:4090/api/auth/callback
ACC_REQUIRED_ROLE=admin
